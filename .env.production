MODE="production"

# ─── Ribeiro Draw! Production Config ─────────────────────────────────────────
# All external services disabled for fully independent deployment on Vercel.

# Backend for sharing scenes (disabled — local-only mode)
VITE_APP_BACKEND_V2_GET_URL=
VITE_APP_BACKEND_V2_POST_URL=

# Libraries (disabled)
VITE_APP_LIBRARY_URL=https://libraries.excalidraw.com
VITE_APP_LIBRARY_BACKEND=

# Excalidraw+ integration (disabled)
VITE_APP_PLUS_LP=
VITE_APP_PLUS_APP=

# AI backend (disabled)
VITE_APP_AI_BACKEND=

# WebSocket collaboration server (disabled)
VITE_APP_WS_SERVER_URL=

# Firebase (disabled — no room persistence)
VITE_APP_FIREBASE_CONFIG=

# Tracking & monitoring (all disabled)
VITE_APP_ENABLE_TRACKING=false
VITE_APP_DISABLE_SENTRY=true

# Debug flags
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=false
VITE_APP_COLLAPSE_OVERLAY=false
VITE_APP_ENABLE_ESLINT=false

# Excalidraw+ export key (disabled)
VITE_APP_PLUS_EXPORT_PUBLIC_KEY=
